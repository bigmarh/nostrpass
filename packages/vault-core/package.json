{
  "name": "@nostrpass/vault-core",
  "version": "0.1.0",
  "description": "Framework-agnostic core library for NostrPass vault operations",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./managers": {
      "types": "./src/managers/index.ts",
      "default": "./src/managers/index.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./adapters/react": {
      "types": "./src/adapters/react.ts",
      "default": "./src/adapters/react.ts"
    },
    "./adapters/solid": {
      "types": "./src/adapters/solid.ts",
      "default": "./src/adapters/solid.ts"
    },
    "./adapters/svelte": {
      "types": "./src/adapters/svelte.ts",
      "default": "./src/adapters/svelte.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts --max-warnings 0",
    "test": "vitest"
  },
  "dependencies": {
    "@nostrpass/types": "workspace:*",
    "@nostrpass/nostrHelpers": "workspace:*",
    "@nostrpass/worker-messenger": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.0.0",
    "react": "^18.0.0",
    "solid-js": "^1.8.0",
    "svelte": "^4.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.0.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "solid-js": "^1.8.0",
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    }
  },
  "keywords": [
    "nostr",
    "vault",
    "crypto",
    "identity",
    "framework-agnostic"
  ]
}
