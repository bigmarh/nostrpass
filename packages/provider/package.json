{
  "name": "@nostrpass/provider",
  "version": "0.0.0",
  "private": true,
  "description": "NostrPass provider SDK (Embassy) - NIP-07 compatible drop-in",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "postbuild": "node scripts/check-size.mjs",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx --max-warnings 0"
  },
  "dependencies": {
    "@nostrpass/messenger": "workspace:*",
    "@nostrpass/nostrHelpers": "workspace:*",
    "@nostrpass/types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.20.0"
  }
}


