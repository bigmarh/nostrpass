# NostrPass Production Environment Configuration
# Copy this file to .env.production and fill in your values

# =============================================================================
# Environment
# =============================================================================
NODE_ENV=production
VITE_ENVIRONMENT=production

# =============================================================================
# URLs
# =============================================================================
# Your vault URL (where users log in and manage identities)
VITE_VAULT_URL=https://vault.nostrpass.com

# Your CDN URL (where the provider SDK is hosted)
VITE_CDN_URL=https://cdn.nostrpass.com

# Provider SDK URL (for apps to load)
VITE_PROVIDER_URL=https://cdn.nostrpass.com/embassy.js

# =============================================================================
# Nostr Relays
# =============================================================================
# Comma-separated list of Nostr relays for vault sync
VITE_NOSTR_RELAYS=wss://relay.nostr.band,wss://relay.damus.io,wss://nos.lol,wss://relay.snort.social

# =============================================================================
# Google Cloud Storage (for deployment)
# =============================================================================
# Your GCP project ID
GCP_PROJECT_ID=nostrpass-prod

# Bucket names (should match your domains)
GCS_CDN_BUCKET=cdn.nostrpass.com
GCS_VAULT_BUCKET=vault.nostrpass.com

# =============================================================================
# CloudFlare (for cache purging)
# =============================================================================
# Get these from CloudFlare dashboard
# My Profile → API Tokens → Create Token (with Cache Purge permission)
CLOUDFLARE_ZONE_ID=20f68d7aa5a83795bf6745195f6174b8
CLOUDFLARE_API_TOKEN=Z1SOYY8xTPinxKQWUHIz8PaHUMh9VyNkYt7JyW0F

# =============================================================================
# Monitoring & Analytics (Optional)
# =============================================================================
# Sentry DSN for error tracking
# VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Google Analytics ID
# VITE_GA_ID=G-XXXXXXXXXX

# =============================================================================
# Feature Flags (Optional)
# =============================================================================
# Enable debug mode (should be false in production)
VITE_DEBUG=false

# Enable dev bypass for testing (should be false in production)
VITE_DEV_BYPASS=false

# =============================================================================
# Build Configuration
# =============================================================================
# Drop console logs in production builds
VITE_DROP_CONSOLE=true

# Enable source maps for debugging (increases bundle size)
VITE_SOURCE_MAP=false
