{
  "name": "@nostrpass/lite-embassy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3420",
    "build": "vite build && vite build --config vite.config.lib.ts",
    "build:lib": "vite build --config vite.config.lib.ts",
    "build:cdn": "vite build --config vite.config.cdn.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nostrpass/lite-api": "workspace:*",
    "@nostrpass/lite-core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vite": "^5.3.3"
  }
}
