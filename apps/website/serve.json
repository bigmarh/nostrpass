{
  "public": "public",
  "rewrites": [
    {
      "source": "/vault/**",
      "destination": "/vault.html"
    },
    {
      "source": "/vault",
      "destination": "/vault.html"
    }
  ],
  "headers": [
    {
      "source": "**/*.@(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
} 