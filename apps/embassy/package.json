{
  "name": "@nostrpass/embassy",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 & vite --port 3200",
    "dev:single": "vite",
    "build": "tsc && vite build",
    "build:lib": "vite build --config vite.config.lib.ts",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@nostrpass/env": "workspace:*",
    "@nostrpass/messenger": "workspace:*",
    "@nostrpass/nostrHelpers": "workspace:*",
    "@nostrpass/types": "workspace:*",
    "nostr-tools": "^2.15.2",
    "@noble/secp256k1": "^2.1.0",
    "@noble/curves": "^1.6.0",
    "solid-js": "^1.8.11"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vite": "^5.3.3",
    "vite-plugin-solid": "^2.8.2"
  }
}