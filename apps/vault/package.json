{
  "name": "@nostrpass/vault",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:worker && vite",
    "build": "npm run build:worker && vite build",
    "build:worker": "vite build --config vite.worker.config.ts",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/ciphers": "^2.0.1",
    "@noble/curves": "^2.0.1",
    "@noble/hashes": "^1.3.2",
    "@noble/secp256k1": "^2.3.0",
    "@nostr-dev-kit/ndk": "^2.14.38",
    "@nostrpass/env": "workspace:*",
    "@nostrpass/messenger": "workspace:*",
    "@nostrpass/nostrHelpers": "workspace:*",
    "@nostrpass/types": "workspace:*",
    "@nostrpass/vault-core": "workspace:*",
    "@nostrpass/worker-messenger": "workspace:*",
    "@scure/bip32": "^2.0.0",
    "@scure/bip39": "^2.0.0",
    "@solidjs/router": "^0.15.3",
    "solid-js": "^1.8.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.3.3",
    "vite": "^5.3.3",
    "vite-plugin-solid": "^2.8.2"
  }
